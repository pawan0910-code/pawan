{%- comment -%} Empty basket (drawer + cart page). Accepts: close_attr {Boolean} — adds data-cart-close to links. {%- endcomment -%}
{%- assign empty_menu = linklists[settings.empty_menu] -%}
<div class="bempty">
  <span class="bempty__icon" aria-hidden="true"><span class="icon">shopping_basket</span></span>
  <p class="t-title-lg c-primary">{{ 'cart.empty' | t }}</p>
  <p class="t-body c-muted">{{ 'cart.empty_sub' | t }}</p>
  {%- if empty_menu.links.size > 0 -%}
    <ul class="bempty__links" role="list">
      {%- for link in empty_menu.links limit: 6 -%}
        <li><a href="{{ link.url }}" class="quick-pill quick-pill--neutral" {% if close_attr %}data-cart-close{% endif %}>{{ link.title }}</a></li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
  <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary btn--lg" {% if close_attr %}data-cart-close{% endif %}>{{ 'general.continue_shopping' | t }}</a>
</div>
