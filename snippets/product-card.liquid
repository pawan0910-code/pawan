{%- comment -%}
  Product card — matches the reference prototype's three card treatments.

  Accepts:
  - product {Object}  Shopify product
  - style {String}    'grid' (Harvest of the Day, default) | 'bowl' (cut-fruit rail) | 'compact' (exotics rail)
  - show_description {Boolean}  bowl style only: show the "what's inside" line
  - lazy {Boolean}    lazy-load the image (default true)

  Data sources (nothing hard-coded):
  - eyebrow:  product.metafields.custom.origin, falling back to product.type
  - unit:     selected variant title (e.g. "500 g"), or product.metafields.custom.unit for single-variant products
  - note:     product.metafields.custom.highlight (e.g. "14° Brix Sweet") — rendered only when set
  - badge:    first matching tag rule from Theme settings → Product cards, else a sale badge when compare-at > price
{%- endcomment -%}
{%- liquid
  assign style = style | default: 'grid'
  assign variant = product.selected_or_first_available_variant

  assign unit = variant.title
  if product.has_only_default_variant
    assign unit = product.metafields.custom.unit.value | default: ''
  endif

  assign eyebrow = product.metafields.custom.origin.value | default: product.type
  assign note = product.metafields.custom.highlight.value

  assign badge = ''
  assign badge_style = ''
  assign product_tags = product.tags | join: ',' | downcase | split: ','
  for i in (1..3)
    assign rule_tag_key = 'badge_' | append: i | append: '_tag'
    assign rule_label_key = 'badge_' | append: i | append: '_label'
    assign rule_style_key = 'badge_' | append: i | append: '_style'
    assign rule_tag = settings[rule_tag_key] | strip | downcase
    if rule_tag != blank and product_tags contains rule_tag
      assign badge = settings[rule_label_key]
      assign badge_style = settings[rule_style_key]
      break
    endif
  endfor
  if badge == blank and variant.compare_at_price > variant.price
    assign saving = variant.compare_at_price | minus: variant.price | times: 100 | divided_by: variant.compare_at_price
    assign badge = 'products.product.save_percent' | t: percent: saving
    assign badge_style = 'secondary'
  endif
  if product.available == false
    assign badge = 'products.product.sold_out' | t
    assign badge_style = 'soft'
  endif

  case style
    when 'grid'
      assign card_class = 'card card--grid'
      assign sizes = '(min-width: 990px) 22vw, (min-width: 750px) 30vw, 46vw'
      assign widths = '200, 300, 400, 500, 600, 800'
    when 'bowl'
      assign card_class = 'card card--rail card--bowl'
      assign sizes = '(min-width: 990px) 22vw, 176px'
      assign widths = '176, 352, 400, 600, 800'
    else
      assign card_class = 'card card--rail card--compact'
      assign sizes = '(min-width: 990px) 22vw, 176px'
      assign widths = '176, 352, 400, 600, 800'
  endcase

  assign loading = 'lazy'
  if lazy == false
    assign loading = 'eager'
  endif

  if style == 'bowl' and show_description
    assign desc = product.description | strip_html | strip_newlines
    assign desc_lower = desc | downcase
    if desc_lower contains 'inside'
      assign desc_parts = desc | split: 'inside'
      assign desc = desc_parts | last | remove_first: ':' | strip
    endif
    assign desc = desc | truncate: 110
  endif
-%}
<article class="{{ card_class }}">
  <div class="card__media">
    {%- if product.featured_media -%}
      {%- assign img_alt = product.featured_media.alt | default: product.title -%}
      {{
        product.featured_media
        | image_url: width: 800
        | image_tag: loading: loading, sizes: sizes, widths: widths, class: 'card__img', alt: img_alt
      }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}

    {%- if badge != blank -%}
      <span class="card__badge badge badge--{{ badge_style }}">{{ badge }}</span>
    {%- endif -%}
    {%- if note != blank and style == 'grid' -%}
      <span class="card__note chip-note">{{ note }}</span>
    {%- endif -%}
  </div>

  <div class="card__body">
    {%- if eyebrow != blank -%}
      <p class="card__eyebrow t-label-sm">{{ eyebrow }}</p>
    {%- endif -%}
    <h3 class="card__title">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h3>
    {%- if unit != blank -%}
      <p class="card__unit t-body-sm">{{ unit }}</p>
    {%- endif -%}
    {%- if style == 'bowl' and show_description and desc != blank -%}
      <p class="card__desc">{{ desc }}</p>
    {%- endif -%}
  </div>

  <div class="card__foot">
    <div class="card__prices">
      <span class="card__price">
        <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
        {{- variant.price | money_without_trailing_zeros -}}
      </span>
      {%- if variant.compare_at_price > variant.price -%}
        <s class="card__compare t-label-sm">
          <span class="visually-hidden">{{ 'products.product.price.was' | t }}</span>
          {{- variant.compare_at_price | money_without_trailing_zeros -}}
        </s>
      {%- endif -%}
    </div>

    {%- form 'product', product, class: 'card__form', data-product-form: '' -%}
      <input type="hidden" name="id" value="{{ variant.id }}">
      <input type="hidden" name="quantity" value="1">
      {%- capture add_label -%}{{ 'products.product.add_to_cart_aria' | t: title: product.title, variant: unit }}{%- endcapture -%}
      <button
        type="submit"
        name="add"
        class="card__add{% unless style == 'grid' %} card__add--round{% endunless %}"
        aria-label="{{ add_label | strip | escape }}"
        {% unless variant.available %}
          disabled
        {% endunless %}
      >
        <span class="icon {% if style == 'grid' %}icon--15{% else %}icon--18{% endif %}" aria-hidden="true">add</span>
        {%- if style == 'grid' -%}
          <span data-label>{{ 'products.product.add' | t }}</span>
        {%- endif -%}
      </button>
    {%- endform -%}
  </div>
</article>
