<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_surface }}">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.pagination.page' | t: number: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif:wght@600;700&family=Plus+Jakarta+Sans:wght@400;600;700&display=swap">
    {%- comment -%}
      Material Symbols, subset to only the icons the theme uses (Google requires the
      list alphabetically sorted). Add more via Theme settings → Icons.
    {%- endcomment -%}
    {%- capture icon_list -%}
      add,agriculture,all_inclusive,arrow_back,arrow_forward,auto_awesome,bolt,calendar_month,celebration,check,check_circle,chevron_left,chevron_right,close,compare_arrows,delete,eco,edit_note,emoji_events,event_repeat,expand_more,favorite,grid_view,home,home_pin,kitchen,lightbulb,local_shipping,location_on,lock,login,logout,mic,my_location,nature,notifications,nutrition,payments,person,qr_code_scanner,quiz,receipt_long,recycling,redeem,remove,restaurant,savings,schedule,search,share,shopping_bag,shopping_basket,storefront,support_agent,swap_horiz,tune,verified,verified_user
      {%- if settings.extra_icons != blank -%},{{ settings.extra_icons | downcase | remove: ' ' }}{%- endif -%}
    {%- endcapture -%}
    {%- assign icon_names = icon_list | strip | split: ',' | compact | uniq | sort | join: ',' -%}
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,400,0..1,0&icon_names={{ icon_names }}&display=block">

    <style>
      :root {
        --c-primary: {{ settings.color_primary }};
        --c-primary-container: {{ settings.color_primary_container }};
        --c-secondary: {{ settings.color_secondary }};
        --c-on-secondary: #ffffff;
        --c-secondary-container: {{ settings.color_secondary_container }};
        --c-surface: {{ settings.color_surface }};
        --c-surface-container-low: {{ settings.color_surface_low }};
        --c-on-surface: {{ settings.color_text }};
        --c-on-surface-variant: {{ settings.color_text_muted }};
      }
    </style>
    {{ 'base.css' | asset_url | stylesheet_tag }}

    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}--{{ template.suffix }}{% endif %}">
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% section 'cart-drawer' %}

    <p class="visually-hidden" id="CartStatus" aria-live="polite" role="status"></p>

    <script>
      window.theme = {
        moneyFormat: {{ shop.money_format | json }},
        routes: {
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          cartUpdate: {{ routes.cart_update_url | json }},
          cart: {{ routes.cart_url | json }},
          comparePage: {{ pages['compare-fruits'].url | json }}
        },
        strings: {
          added: {{ 'products.product.added' | t | json }},
          addedToCart: {{ 'products.product.added_to_cart' | t | json }},
          soldOut: {{ 'products.product.sold_out' | t | json }},
          unavailable: {{ 'products.product.unavailable' | t | json }},
          addError: {{ 'products.product.add_error' | t | json }},
          cartError: {{ 'cart.error' | t | json }},
          listening: {{ 'general.search.listening' | t | json }}
        }
      };
    </script>
  </body>
</html>
