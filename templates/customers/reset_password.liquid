<div class="container acct-page"><div class="panel acct-card">
  <h1 class="t-display c-primary">{{ 'customer.reset.title' | t }}</h1>
  {%- form 'reset_customer_password', class: 'acct-form' -%}
    {{ form.errors | default_errors }}
    <div class="field"><label class="t-label" for="ResetPass">{{ 'customer.fields.password' | t }}</label><input id="ResetPass" type="password" name="customer[password]" autocomplete="new-password" required></div>
    <div class="field"><label class="t-label" for="ResetPass2">{{ 'customer.fields.password_confirm' | t }}</label><input id="ResetPass2" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
    <button type="submit" class="btn btn--primary btn--lg btn--block">{{ 'customer.reset.submit' | t }}</button>
  {%- endform -%}
</div></div>
