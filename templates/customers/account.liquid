{%- assign customer_name = customer.first_name | default: customer.email -%}
<div class="container acct-page">
  <header class="page-head acct-head">
    <h1 class="page-head__title t-display">{{ 'customer.account.hello' | t: name: customer_name }}</h1>
    <a href="{{ routes.account_logout_url }}" class="btn btn--outline"><span class="icon icon--18" aria-hidden="true">logout</span>{{ 'customer.account.log_out' | t }}</a>
  </header>
  <div class="acct-grid">
    <section class="panel">
      <h2 class="t-title-lg c-primary">{{ 'customer.account.orders' | t }}</h2>
      {%- paginate customer.orders by 20 -%}
        {%- if customer.orders.size > 0 -%}
          <ul class="acct-orders" role="list">
            {%- for order in customer.orders -%}
              <li><a href="{{ order.customer_url }}" class="acct__link"><span class="icon" aria-hidden="true">receipt_long</span><span>{{ order.name }} · {{ order.created_at | date: '%d %b %Y' }}<br><small class="c-muted">{{ order.fulfillment_status_label }} · {{ order.total_price | money_without_trailing_zeros }}</small></span><span class="icon icon--18" aria-hidden="true">chevron_right</span></a></li>
            {%- endfor -%}
          </ul>
          {%- render 'pagination', paginate: paginate -%}
        {%- else -%}
          <p class="t-body c-muted">{{ 'customer.account.no_orders' | t }}</p>
          <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">{{ 'general.continue_shopping' | t }}</a>
        {%- endif -%}
      {%- endpaginate -%}
    </section>
    <section class="panel">
      <h2 class="t-title-lg c-primary">{{ 'customer.account.addresses' | t }}</h2>
      {%- if customer.default_address -%}<p class="t-body">{{ customer.default_address | format_address }}</p>{%- endif -%}
      <a href="{{ routes.account_addresses_url }}" class="btn btn--outline">{{ 'customer.account.manage_addresses' | t }}</a>
    </section>
  </div>
</div>
