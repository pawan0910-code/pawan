<section class="section" aria-labelledby="StoriesHeading-{{ section.id }}">
  <div class="container">
    <div class="section-head">
      <h2 id="StoriesHeading-{{ section.id }}" class="section-head__title t-title-lg">{{ section.settings.heading }}</h2>
      {%- if section.settings.view_all_label != blank -%}
        <a href="{{ section.settings.view_all_link | default: routes.collections_url }}" class="section-head__link t-label">{{ section.settings.view_all_label }}</a>
      {%- endif -%}
    </div>

    <ul class="stories scroller" role="list">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'collection' -%}
            {%- liquid
              assign col = block.settings.collection
              assign label = block.settings.label | default: col.title
              assign img = block.settings.image | default: col.featured_image
              if img == blank
                for p in col.products limit: 8
                  if p.featured_media
                    assign img = p.featured_media
                    break
                  endif
                endfor
              endif
            -%}
            <li {{ block.shopify_attributes }}>
              <a href="{{ col.url | default: routes.collections_url }}" class="story">
                <span class="story__ring">
                  {%- if img != blank -%}
                    {{ img | image_url: width: 192, height: 192, crop: 'center' | image_tag: alt: '', loading: 'lazy', width: 96, height: 96 }}
                  {%- else -%}
                    {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </span>
                <span class="story__label">{{ label | default: 'Collection' }}</span>
              </a>
            </li>
          {%- when 'link' -%}
            <li {{ block.shopify_attributes }}>
              <a href="{{ block.settings.link | default: routes.collections_url }}" class="story">
                <span class="story__ring story__ring--icon">
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 192, height: 192, crop: 'center' | image_tag: alt: '', loading: 'lazy', width: 96, height: 96 }}
                  {%- else -%}
                    <span class="icon icon--28" aria-hidden="true">{{ block.settings.icon | strip }}</span>
                  {%- endif -%}
                </span>
                <span class="story__label">{{ block.settings.label }}</span>
              </a>
            </li>
        {%- endcase -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Browse collections",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Browse Harvest" },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "View All" },
    { "type": "url", "id": "view_all_link", "label": "View all link", "info": "Defaults to the collections list." }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Label", "info": "Defaults to the collection title." },
        { "type": "image_picker", "id": "image", "label": "Image override", "info": "Defaults to the collection image, then the first product image." }
      ]
    },
    {
      "type": "link",
      "name": "Icon link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Daily Plans" },
        { "type": "text", "id": "icon", "label": "Icon (Material Symbols name)", "default": "all_inclusive" },
        { "type": "image_picker", "id": "image", "label": "Image (replaces icon)" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Browse collections",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
