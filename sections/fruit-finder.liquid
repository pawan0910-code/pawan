{%- comment -%}
  "What should I eat?" — two quick questions, then the best-matching fruits ranked by
  real nutrition data (Fruit Guide metaobjects). No dead ends: every result can be added.
{%- endcomment -%}
<div class="container" data-fruit-finder>
  <header class="page-head">
    <p class="ft-eyebrow t-label-sm">{{ section.settings.eyebrow }}</p>
    <h1 class="page-head__title t-display">{{ section.settings.heading | default: page.title }}</h1>
    {%- if section.settings.text != blank -%}
      <p class="page-head__text t-body-lg">{{ section.settings.text }}</p>
    {%- endif -%}
  </header>

  <form class="panel ft-finder" data-finder-form>
    <fieldset class="ft-q">
      <legend class="t-title c-primary">1. {{ 'fruit_tools.finder.q_goal' | t }}</legend>
      <div class="pill-options pill-options--lg">
        {%- assign goals = 'vitc,fiber,water,light,lowsugar,energy' | split: ',' -%}
        {%- assign emojis = '🍊,🌾,💧,🪶,🍃,⚡' | split: ',' -%}
        {%- for goal in goals -%}
          {%- assign key = 'fruit_tools.finder.goal_' | append: goal -%}
          <label class="pill-option">
            <input type="radio" name="goal" value="{{ goal }}" {% if forloop.first %}checked{% endif %}>
            <span>{{ emojis[forloop.index0] }} {{ key | t }}</span>
          </label>
        {%- endfor -%}
      </div>
    </fieldset>
    <fieldset class="ft-q">
      <legend class="t-title c-primary">2. {{ 'fruit_tools.finder.q_taste' | t }}</legend>
      <div class="pill-options pill-options--lg">
        {%- assign tastes = 'any,sweet,tangy,creamy' | split: ',' -%}
        {%- for taste in tastes -%}
          {%- assign key = 'fruit_tools.finder.taste_' | append: taste -%}
          <label class="pill-option">
            <input type="radio" name="taste" value="{{ taste }}" {% if forloop.first %}checked{% endif %}>
            <span>{{ key | t }}</span>
          </label>
        {%- endfor -%}
      </div>
    </fieldset>
    <label class="ft-toggle t-body">
      <input type="checkbox" name="season" value="1">
      <span>{{ 'fruit_tools.finder.season_only' | t }}</span>
    </label>
  </form>

  <h2 class="t-title-lg c-primary ft-subhead" data-finder-title></h2>
  <ol class="ft-grid" data-finder-list aria-live="polite">
    <noscript><li class="t-body c-muted">{{ 'fruit_tools.needs_js' | t }}</li></noscript>
  </ol>
  <p class="t-body-sm c-muted ft-note">{{ 'fruit_tools.disclaimer' | t }}</p>
</div>

{% render 'fruit-data' %}
<script src="{{ 'fruit-tools.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Fruit finder",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Fruit finder" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Not sure what to pick?" },
    { "type": "textarea", "id": "text", "label": "Intro", "default": "Answer two quick questions. We’ll rank our fruits by real nutrition numbers and taste." }
  ],
  "presets": [{ "name": "Fruit finder" }]
}
{% endschema %}
