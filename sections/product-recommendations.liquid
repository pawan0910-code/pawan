{%- comment -%}
  "You may also like" — Shopify product recommendations, loaded after the page
  (the recommendations object is only populated when this section is requested
  from routes.product_recommendations_url).
{%- endcomment -%}
<div
  class="product-recommendations"
  data-recommendations
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent=related"
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <section class="section" aria-labelledby="RecsHeading-{{ section.id }}">
      <div class="container">
        <div class="section-head">
          <h2 id="RecsHeading-{{ section.id }}" class="section-head__title t-headline">
            {%- assign heading = section.settings.heading -%}
            {%- if heading == blank -%}{%- assign heading = 'products.product.related' | t -%}{%- endif -%}
            {{- heading -}}
          </h2>
        </div>
        <ul class="rail scroller" role="list" style="--cols-desktop: 4;">
          {%- for product in recommendations.products -%}
            <li class="rail__item">{%- render 'product-card', product: product, style: 'compact' -%}</li>
          {%- endfor -%}
        </ul>
      </div>
    </section>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Related products",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 10, "step": 1, "default": 6 }
  ],
  "presets": [{ "name": "Related products" }]
}
{% endschema %}
