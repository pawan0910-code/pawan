{%- comment -%}
  Searchable fruit guide ("Know Your Fruit" / "Fruit Engine"). Data: Fruit Guide metaobjects.
{%- endcomment -%}
<div class="container" data-fruit-guide>
  <header class="page-head">
    <p class="ft-eyebrow t-label-sm">{{ section.settings.eyebrow }}</p>
    <h1 class="page-head__title t-display">{{ section.settings.heading | default: page.title }}</h1>
    {%- if section.settings.text != blank -%}
      <p class="page-head__text t-body-lg">{{ section.settings.text }}</p>
    {%- endif -%}
  </header>

  <div class="searchbar ft-search">
    <span class="icon icon--20" aria-hidden="true">search</span>
    <label class="visually-hidden" for="GuideSearch-{{ section.id }}">{{ 'fruit_tools.guide.search' | t }}</label>
    <input id="GuideSearch-{{ section.id }}" type="search" placeholder="{{ 'fruit_tools.guide.search' | t }}" autocomplete="off" data-guide-search>
  </div>

  <div class="scroller quick-pills ft-chips" role="group" aria-label="{{ 'fruit_tools.guide.filters' | t }}" data-guide-filters>
    <button type="button" class="quick-pill quick-pill--neutral" data-filter="all" aria-pressed="true">{{ 'fruit_tools.guide.all' | t }}</button>
    <button type="button" class="quick-pill quick-pill--neutral" data-filter="season" aria-pressed="false">🌿 {{ 'fruit_tools.guide.in_season' | t }}</button>
    <button type="button" class="quick-pill quick-pill--neutral" data-filter="vitc" aria-pressed="false">🍊 {{ 'fruit_tools.guide.vitc' | t }}</button>
    <button type="button" class="quick-pill quick-pill--neutral" data-filter="fiber" aria-pressed="false">🌾 {{ 'fruit_tools.guide.fiber' | t }}</button>
    <button type="button" class="quick-pill quick-pill--neutral" data-filter="water" aria-pressed="false">💧 {{ 'fruit_tools.guide.water' | t }}</button>
    <button type="button" class="quick-pill quick-pill--neutral" data-filter="light" aria-pressed="false">🪶 {{ 'fruit_tools.guide.light' | t }}</button>
  </div>

  <p class="t-body-sm c-muted ft-count" data-guide-count aria-live="polite"></p>
  <ul class="ft-grid" role="list" data-guide-list>
    <noscript><li class="t-body c-muted">{{ 'fruit_tools.needs_js' | t }}</li></noscript>
  </ul>
  <p class="t-body-sm c-muted ft-note">{{ 'fruit_tools.disclaimer' | t }}</p>
</div>

{% render 'fruit-data' %}
<script src="{{ 'fruit-tools.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Fruit guide",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Know your fruit" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Every fruit, explained simply" },
    { "type": "textarea", "id": "text", "label": "Intro", "default": "Search any fruit to see how to pick it, store it and what’s inside — real numbers per 100 g." }
  ],
  "presets": [{ "name": "Fruit guide" }]
}
{% endschema %}
