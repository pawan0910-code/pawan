<div class="container">
  <header class="page-head">
    <h1 class="page-head__title t-display">{{ blog.title }}</h1>
    {%- if blog.all_tags.size > 0 -%}
      <div class="quick-pills scroller" style="margin-top: var(--space-md);">
        <a href="{{ blog.url }}" class="quick-pill {% if current_tags == blank %}quick-pill--mint{% else %}quick-pill--neutral{% endif %}">{{ 'blogs.all' | t }}</a>
        {%- for tag in blog.all_tags -%}
          <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="quick-pill {% if current_tags contains tag %}quick-pill--mint{% else %}quick-pill--neutral{% endif %}">{{ tag }}</a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </header>
  {%- paginate blog.articles by 12 -%}
    <ul class="article-grid" role="list">
      {%- for article in blog.articles -%}
        <li class="article-card panel">
          {%- if article.image -%}
            <a href="{{ article.url }}" class="article-card__media" tabindex="-1" aria-hidden="true">
              {{ article.image | image_url: width: 800 | image_tag: widths: '400, 600, 800', sizes: '(min-width: 990px) 30vw, (min-width: 750px) 45vw, 90vw', loading: 'lazy', alt: '' }}
            </a>
          {%- endif -%}
          <p class="t-label-sm c-secondary">{{ article.published_at | time_tag: format: 'date' }}</p>
          <h2 class="article-card__title t-headline"><a href="{{ article.url }}">{{ article.title }}</a></h2>
          <p class="t-body c-muted">{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p>
        </li>
      {%- endfor -%}
    </ul>
    {%- render 'pagination', paginate: paginate -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Blog posts",
  "tag": "section",
  "settings": []
}
{% endschema %}
