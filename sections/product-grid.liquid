{%- assign col = section.settings.collection -%}
<section class="section" aria-labelledby="GridHeading-{{ section.id }}">
  <div class="container">
    <div class="section-head">
      <h2 id="GridHeading-{{ section.id }}" class="section-head__title t-headline">
        {{- section.settings.heading | default: col.title -}}
        {%- if section.settings.heading_icon != blank -%}
          <span class="icon icon--20" aria-hidden="true">{{ section.settings.heading_icon | strip }}</span>
        {%- endif -%}
      </h2>
      {%- if section.settings.caption != blank -%}
        {%- if section.settings.caption_links_to_collection and col != blank -%}
          <a href="{{ col.url }}" class="section-head__link t-label">{{ section.settings.caption }}</a>
        {%- else -%}
          <span class="section-head__caption t-label-sm">{{ section.settings.caption }}</span>
        {%- endif -%}
      {%- endif -%}
    </div>

    {%- if col != blank and col.products_count > 0 -%}
      <ul class="product-grid" role="list" style="--cols-desktop: {{ section.settings.columns_desktop }};">
        {%- for product in col.products limit: section.settings.limit -%}
          <li class="product-grid__item">
            {%- render 'product-card', product: product, style: 'grid', lazy: true -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="section-head__sub t-body-sm">{{ 'sections.product_list.empty' | t }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product grid",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Harvest of the Day", "info": "Defaults to the collection title." },
    { "type": "text", "id": "heading_icon", "label": "Heading icon (Material Symbols name)", "default": "verified" },
    { "type": "text", "id": "caption", "label": "Right-side caption", "default": "View All" },
    { "type": "checkbox", "id": "caption_links_to_collection", "label": "Caption links to the collection", "default": true },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 16, "step": 1, "default": 4 },
    { "type": "range", "id": "columns_desktop", "label": "Columns on desktop", "min": 3, "max": 5, "step": 1, "default": 4, "info": "Mobile always shows 2 columns, tablet 3." }
  ],
  "presets": [{ "name": "Product grid" }]
}
{% endschema %}
