<div class="container" style="max-width: 32rem; padding-block: 4rem;">
  <div class="panel" style="display: flex; flex-direction: column; gap: var(--space-md); text-align: center;">
    <span class="icon icon--28 c-primary" aria-hidden="true" style="margin-inline: auto;">eco</span>
    <h1 class="t-display c-primary">{{ shop.name }}</h1>
    {%- if shop.password_message != blank -%}
      <p class="t-body-lg c-muted">{{ shop.password_message }}</p>
    {%- endif -%}
    {%- form 'storefront_password', class: 'field' -%}
      {%- if form.errors -%}<p class="form-message form-message--error">{{ form.errors | default_errors }}</p>{%- endif -%}
      <label for="Password" class="t-label">{{ 'general.password.label' | t }}</label>
      <input type="password" name="password" id="Password" autocomplete="current-password">
      <button type="submit" class="btn btn--primary btn--lg" style="margin-top: .5rem;">{{ 'general.password.enter' | t }}</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Password",
  "tag": "section",
  "settings": []
}
{% endschema %}
