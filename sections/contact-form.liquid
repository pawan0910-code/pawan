{%- liquid
  assign message_label = section.settings.message_label
  if message_label == blank
    assign message_label = 'contact.message' | t
  endif
  assign button_label = section.settings.button_label
  if button_label == blank
    assign button_label = 'contact.send' | t
  endif
-%}
<div class="container">
  <div class="panel contact" style="max-width: 40rem;">
    {%- if section.settings.heading != blank -%}
      <h2 class="t-title-lg c-primary">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- form 'contact', id: 'ContactForm', class: 'contact__form' -%}
      {%- if form.posted_successfully? -%}
        <p class="contact__status c-secondary t-body" role="status" tabindex="-1" autofocus>{{ 'contact.success' | t }}</p>
      {%- elsif form.errors -%}
        <div class="contact__status t-body" role="alert" style="color: var(--c-error);">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="field">
        <label for="ContactForm-name" class="t-label">{{ 'contact.name' | t }}</label>
        <input id="ContactForm-name" type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}">
      </div>
      <div class="field">
        <label for="ContactForm-email" class="t-label">{{ 'contact.email' | t }} *</label>
        <input id="ContactForm-email" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}">
      </div>
      <div class="field">
        <label for="ContactForm-phone" class="t-label">{{ 'contact.phone' | t }}</label>
        <input id="ContactForm-phone" type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}">
      </div>
      <div class="field">
        <label for="ContactForm-body" class="t-label">{{ message_label }}</label>
        <textarea id="ContactForm-body" name="contact[body]" rows="5">{{ form.body }}</textarea>
      </div>
      <button type="submit" class="btn btn--primary btn--lg">{{ button_label }}</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Contact form",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Send us a message" },
    { "type": "text", "id": "message_label", "label": "Message label", "info": "e.g. “Occasion, quantity, budget and delivery date”." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Send" }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
