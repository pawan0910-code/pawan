{%- paginate collection.products by section.settings.per_page -%}
  <div class="container">
    <header class="page-head">
      <nav class="breadcrumbs t-label" aria-label="{{ 'general.breadcrumbs' | t }}">
        <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a>
        <span aria-hidden="true">/</span>
        <a href="{{ routes.collections_url }}">{{ 'collections.all' | t }}</a>
      </nav>
      <h1 class="page-head__title t-display">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <div class="page-head__text rte">{{ collection.description }}</div>
      {%- endif -%}
    </header>

    <form class="filters" id="CollectionFilters" action="{{ collection.url }}" method="get">
      <div class="toolbar" style="margin-bottom: 0;">
        <div class="filters__row">
          {%- for filter in collection.filters -%}
            {%- if filter.type == 'list' or filter.type == 'boolean' -%}
              <details class="filter">
                <summary class="quick-pill quick-pill--neutral" style="cursor: pointer;">
                  {{ filter.label }}
                  {%- if filter.active_values.size > 0 %} ({{ filter.active_values.size }}){% endif -%}
                  <span class="icon icon--14" aria-hidden="true">expand_more</span>
                </summary>
                <fieldset class="filter__panel" style="border: 0; margin: 0;">
                  <legend class="visually-hidden">{{ filter.label }}</legend>
                  {%- for value in filter.values -%}
                    <label class="filter__option{% if value.count == 0 and value.active == false %} filter__option--disabled{% endif %}">
                      <input
                        type="checkbox"
                        name="{{ value.param_name }}"
                        value="{{ value.value }}"
                        data-autosubmit
                        {% if value.active %}checked{% endif %}
                        {% if value.count == 0 and value.active == false %}disabled{% endif %}
                      >
                      <span>{{ value.label }}</span>
                      <span class="filter__count">({{ value.count }})</span>
                    </label>
                  {%- endfor -%}
                </fieldset>
              </details>
            {%- elsif filter.type == 'price_range' -%}
              <details class="filter">
                <summary class="quick-pill quick-pill--neutral" style="cursor: pointer;">
                  {{ filter.label }}
                  <span class="icon icon--14" aria-hidden="true">expand_more</span>
                </summary>
                <div class="filter__panel">
                  <div class="field">
                    <label for="Filter-min">{{ 'collections.filters.from' | t }} ({{ cart.currency.symbol }})</label>
                    <input id="Filter-min" type="number" name="{{ filter.min_value.param_name }}" value="{% if filter.min_value.value %}{{ filter.min_value.value | money_without_currency | remove: ',' }}{% endif %}" placeholder="0" min="0" data-autosubmit>
                  </div>
                  <div class="field">
                    <label for="Filter-max">{{ 'collections.filters.to' | t }} ({{ cart.currency.symbol }})</label>
                    <input id="Filter-max" type="number" name="{{ filter.max_value.param_name }}" value="{% if filter.max_value.value %}{{ filter.max_value.value | money_without_currency | remove: ',' }}{% endif %}" placeholder="{{ filter.range_max | money_without_currency | remove: ',' }}" min="0" data-autosubmit>
                  </div>
                </div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <div class="select">
          <label class="visually-hidden" for="SortBy">{{ 'collections.sort_by' | t }}</label>
          {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
          <select id="SortBy" name="sort_by" data-autosubmit>
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value | escape }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
            {%- endfor -%}
          </select>
          <span class="icon icon--18" aria-hidden="true">expand_more</span>
        </div>
      </div>

      {%- assign active_count = 0 -%}
      {%- for filter in collection.filters -%}
        {%- assign active_count = active_count | plus: filter.active_values.size -%}
        {%- if filter.min_value.value or filter.max_value.value -%}{%- assign active_count = active_count | plus: 1 -%}{%- endif -%}
      {%- endfor -%}
      {%- if active_count > 0 -%}
        <div class="active-filters">
          {%- for filter in collection.filters -%}
            {%- for value in filter.active_values -%}
              <a href="{{ value.url_to_remove }}" class="quick-pill quick-pill--mint">
                {{ value.label }} <span class="icon icon--14" aria-hidden="true">close</span>
                <span class="visually-hidden">{{ 'collections.filters.remove' | t }}</span>
              </a>
            {%- endfor -%}
          {%- endfor -%}
          <a href="{{ collection.url }}?sort_by={{ sort_by }}" class="quick-pill quick-pill--neutral">{{ 'collections.filters.clear_all' | t }}</a>
        </div>
      {%- endif -%}
      <noscript><button type="submit" class="btn btn--primary" style="margin-top: .5rem;">{{ 'collections.filters.apply' | t }}</button></noscript>
    </form>

    <p class="t-body-sm c-muted" style="margin-bottom: var(--space-sm);">{{ 'collections.product_count' | t: count: collection.products_count }}</p>

    {%- if collection.products.size > 0 -%}
      <ul class="product-grid" role="list" style="--cols-desktop: {{ section.settings.columns_desktop }};">
        {%- for product in collection.products -%}
          <li>{%- render 'product-card', product: product, style: 'grid' -%}</li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <div class="empty-state">
        <span class="icon" aria-hidden="true">eco</span>
        <p class="t-body-lg">{{ 'collections.empty' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">{{ 'general.continue_shopping' | t }}</a>
      </div>
    {%- endif -%}

    {%- render 'pagination', paginate: paginate -%}
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Collection products",
  "tag": "section",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "range", "id": "columns_desktop", "label": "Columns on desktop", "min": 3, "max": 5, "step": 1, "default": 4 }
  ]
}
{% endschema %}
