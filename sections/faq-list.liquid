{%- assign faqs = shop.metaobjects.faq.values -%}
<div class="container">
  <header class="page-head">
    <h1 class="page-head__title t-display">{{ section.settings.heading | default: page.title }}</h1>
  </header>
  {%- if faqs.size > 0 -%}
    {%- liquid
      assign category_list = '|'
      for f in faqs
        assign c = f.category.value | default: 'General' | strip
        assign token = '|' | append: c | append: '|'
        unless category_list contains token
          assign category_list = category_list | append: c | append: '|'
        endunless
      endfor
      assign categories = category_list | split: '|' | compact
    -%}
    {%- for category in categories -%}
      {%- if category == blank -%}{%- continue -%}{%- endif -%}
      <h2 class="t-title-lg c-primary ft-subhead">{{ category }}</h2>
      <div class="ft-accordion">
        {%- for f in faqs -%}
          {%- assign fc = f.category.value | default: 'General' | strip -%}
          {%- if fc == category -%}
            <details class="panel ft-details">
              <summary class="ft-details__summary">
                <span class="t-title">{{ f.question.value }}</span>
                <span class="icon icon--20" aria-hidden="true">expand_more</span>
              </summary>
              <div class="ft-details__body"><p class="t-body">{{ f.answer.value | newline_to_br }}</p></div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endfor -%}
  {%- else -%}
    <div class="rte prose">{{ page.content }}</div>
  {%- endif -%}
  {%- if section.settings.contact_link != blank -%}
    <div class="panel ft-cta">
      <p class="t-title c-primary">{{ section.settings.contact_heading }}</p>
      <a href="{{ section.settings.contact_link }}" class="btn btn--primary">{{ section.settings.contact_label }}</a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "FAQ list",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "info": "Defaults to the page title." },
    { "type": "paragraph", "content": "Questions come from Content → Metaobjects → FAQ, grouped by category." },
    { "type": "text", "id": "contact_heading", "label": "Contact heading", "default": "Still have a question?" },
    { "type": "text", "id": "contact_label", "label": "Contact button", "default": "Contact us" },
    { "type": "url", "id": "contact_link", "label": "Contact link" }
  ],
  "presets": [{ "name": "FAQ list" }]
}
{% endschema %}
