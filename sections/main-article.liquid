<article class="container prose" style="margin-inline: auto;">
  <header class="page-head">
    <nav class="breadcrumbs t-label" aria-label="{{ 'general.breadcrumbs' | t }}">
      <a href="{{ blog.url }}">{{ blog.title }}</a>
    </nav>
    <h1 class="page-head__title t-display">{{ article.title }}</h1>
    <p class="t-body-sm c-muted" style="margin-top: .5rem;">{{ article.published_at | time_tag: format: 'date' }}{% if article.author != blank %} · {{ article.author }}{% endif %}</p>
  </header>
  {%- if article.image -%}
    <div class="article-hero">
      {{ article.image | image_url: width: 1600 | image_tag: widths: '600, 900, 1200, 1600', sizes: '(min-width: 990px) 736px, 100vw', loading: 'eager', alt: article.title }}
    </div>
  {%- endif -%}
  <div class="rte">{{ article.content }}</div>
  <p style="margin-top: 2rem;"><a href="{{ blog.url }}" class="btn btn--outline"><span class="icon icon--16" aria-hidden="true">arrow_back</span>{{ 'blogs.back' | t: title: blog.title }}</a></p>
</article>

{% schema %}
{
  "name": "Blog post",
  "tag": "section",
  "settings": []
}
{% endschema %}
