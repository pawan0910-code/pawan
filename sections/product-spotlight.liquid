{%- liquid
  assign product = section.settings.product
  assign variant = product.selected_or_first_available_variant
  assign form_id = 'SpotlightForm-' | append: section.id
  assign description = section.settings.text | default: product.description
  assign description = description | strip_html | truncate: 180
  assign add_label = section.settings.button_label
  if add_label == blank
    assign add_label = 'products.product.add_to_cart' | t
  endif
-%}
{%- if product != blank -%}
  <section class="section" aria-labelledby="SpotlightHeading-{{ section.id }}">
    <div class="container">
      <div class="spotlight" data-spotlight>
        <div class="spotlight__head">
          <div>
            {%- if section.settings.eyebrow != blank -%}
              <p class="spotlight__eyebrow t-label-sm">{{ section.settings.eyebrow }}</p>
            {%- endif -%}
            <h2 id="SpotlightHeading-{{ section.id }}" class="spotlight__title t-headline">
              <a href="{{ product.url }}">{{ section.settings.heading | default: product.title }}</a>
            </h2>
          </div>
          {%- if section.settings.badge != blank -%}
            <span class="spotlight__badge badge badge--mint">{{ section.settings.badge }}</span>
          {%- endif -%}
        </div>

        <div class="spotlight__body">
          <a href="{{ product.url }}" class="spotlight__media" tabindex="-1" aria-hidden="true">
            {%- if product.featured_media -%}
              {{
                product.featured_media
                | image_url: width: 800
                | image_tag: widths: '256, 400, 600, 800', sizes: '(min-width: 990px) 320px, (min-width: 750px) 224px, 128px', loading: 'lazy', alt: ''
              }}
            {%- else -%}
              {{ 'product-2' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </a>

          <div class="spotlight__info">
            {%- if description != blank -%}
              <p class="spotlight__text t-body-sm">{{ description }}</p>
            {%- endif -%}

            {%- form 'product', product, id: form_id, class: 'spotlight__form', data-product-form: '', data-variant-form: '' -%}
              <input type="hidden" name="id" value="{{ variant.id }}" data-variant-id>
              <input type="hidden" name="quantity" value="1">

              {%- unless product.has_only_default_variant -%}
                {%- for option in product.options_with_values -%}
                  <fieldset class="pill-options">
                    <legend class="visually-hidden">{{ option.name }}</legend>
                    {%- for value in option.values -%}
                      <label class="pill-option">
                        <input
                          type="radio"
                          name="{{ form_id }}-{{ option.position }}"
                          value="{{ value | escape }}"
                          data-option-index="{{ forloop.parentloop.index0 }}"
                          {% if option.selected_value == value %}checked{% endif %}
                        >
                        <span>{{ value }}</span>
                      </label>
                    {%- endfor -%}
                  </fieldset>
                {%- endfor -%}
              {%- else -%}
                {%- if product.metafields.custom.unit.value != blank -%}
                  <div class="pill-options" aria-hidden="true">
                    <span class="pill-option pill-option--static"><span>{{ product.metafields.custom.unit.value }}</span></span>
                  </div>
                {%- endif -%}
              {%- endunless -%}

              <div class="spotlight__foot">
                <p class="spotlight__price">
                  <span data-price>{{ variant.price | money_without_trailing_zeros }}</span>
                  {%- unless product.has_only_default_variant -%}
                    <span class="spotlight__per">/ <span data-variant-title>{{ variant.title }}</span></span>
                  {%- endunless -%}
                </p>
                <button
                  type="submit"
                  name="add"
                  class="btn btn--amber spotlight__cta t-label"
                  data-add-button
                  data-label-add="{{ add_label | escape }}"
                  {% unless variant.available %}disabled{% endunless %}
                >
                  <span data-label>
                    {%- if variant.available -%}
                      {{ add_label }}
                    {%- else -%}
                      {{ 'products.product.sold_out' | t }}
                    {%- endif -%}
                  </span>
                </button>
              </div>
              <script type="application/json" data-variants>
                {{ product.variants | json }}
              </script>
            {%- endform -%}
          </div>
        </div>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Product spotlight",
  "tag": "div",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Orchard Direct" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Defaults to the product title." },
    { "type": "text", "id": "badge", "label": "Badge", "default": "Residue Free", "info": "Leave blank to hide." },
    { "type": "textarea", "id": "text", "label": "Description", "info": "Defaults to the product description." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Add" }
  ],
  "presets": [{ "name": "Product spotlight" }]
}
{% endschema %}
