<section class="section" aria-labelledby="ToolsHeading-{{ section.id }}">
  <div class="container">
    <div class="section-head">
      <div>
        <h2 id="ToolsHeading-{{ section.id }}" class="section-head__title t-headline">
          {{- section.settings.heading -}}
          <span class="icon icon--20" aria-hidden="true">lightbulb</span>
        </h2>
        {%- if section.settings.subheading != blank -%}
          <p class="section-head__sub t-body-sm">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    </div>
    <ul class="ft-tools" role="list">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          <a href="{{ block.settings.link | default: '#' }}" class="ft-tool">
            <span class="ft-tool__icon" aria-hidden="true"><span class="icon">{{ block.settings.icon | strip }}</span></span>
            <span class="ft-tool__text">
              <span class="t-title c-primary">{{ block.settings.title }}</span>
              <span class="t-body-sm c-muted">{{ block.settings.text }}</span>
            </span>
            <span class="icon icon--18 c-secondary" aria-hidden="true">arrow_forward</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Fruit tools shortcuts",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pick smarter" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Real nutrition numbers, simple answers" }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "tool",
      "name": "Tool",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (Material Symbols name)", "default": "compare_arrows" },
        { "type": "text", "id": "title", "label": "Title", "default": "Compare fruits" },
        { "type": "text", "id": "text", "label": "Text", "default": "Any two fruits, side by side" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Fruit tools shortcuts", "blocks": [{ "type": "tool" }] }]
}
{% endschema %}
